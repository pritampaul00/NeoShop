src\pages\OrderDetails.tsx:      );
src\pages\OrderDetails.tsx:      return;
src\pages\OrderDetails.tsx:    }
src\pages\OrderDetails.tsx:
src\pages\OrderDetails.tsx:    const confirmed = window.confirm(
