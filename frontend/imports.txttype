src\pages\AdminOrderDetails.tsx:    );
src\pages\AdminOrderDetails.tsx:  }
src\pages\AdminOrderDetails.tsx:
src\pages\AdminOrderDetails.tsx:  if (error || !order) {
src\pages\AdminOrderDetails.tsx:    return (
src\pages\AdminOrderDetails.tsx:      <main className="page">
src\pages\AdminOrderDetails.tsx:        <div className="error">
src\pages\AdminOrderDetails.tsx:          {error || "Order not found."}
src\pages\AdminOrderDetails.tsx:        </div>
src\pages\AdminOrderDetails.tsx:      </main>
src\pages\AdminOrderDetails.tsx:    );
src\pages\AdminOrderDetails.tsx:  }
src\pages\AdminOrderDetails.tsx:
src\pages\AdminOrderDetails.tsx:  return (
src\pages\AdminOrderDetails.tsx:    <main className="page">
src\pages\AdminOrderDetails.tsx:      <section className="order-details-section">
src\pages\AdminOrderDetails.tsx:
src\pages\AdminOrderDetails.tsx:        <Link
src\pages\AdminOrderDetails.tsx:          to="/admin"
src\pages\AdminOrderDetails.tsx:          className="back-to-orders"
src\pages\AdminOrderDetails.tsx:        >
src\pages\AdminOrderDetails.tsx:          ← Back to Admin Dashboard
