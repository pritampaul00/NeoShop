src\pages\OrderDetails.tsx:      }
src\pages\OrderDetails.tsx:    } finally {
src\pages\OrderDetails.tsx:      setCancelling(false);
src\pages\OrderDetails.tsx:    }
src\pages\OrderDetails.tsx:  };
src\pages\OrderDetails.tsx:
src\pages\OrderDetails.tsx:  if (loading) {
