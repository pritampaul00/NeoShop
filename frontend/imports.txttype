src\pages\AdminOrderDetails.tsx:import { Link, useParams } from "react-router-dom";
src\pages\AdminOrderDetails.tsx:import keycloak from "../auth/keycloak";
src\pages\AdminOrderDetails.tsx:import {
src\pages\AdminOrderDetails.tsx:  getOrderById,
src\pages\AdminOrderDetails.tsx:} from "../services/orderService";
src\pages\AdminOrderDetails.tsx:import type { Order } from "../services/orderService";
src\pages\AdminOrderDetails.tsx:
src\pages\AdminOrderDetails.tsx:function AdminOrderDetails() {
src\pages\AdminOrderDetails.tsx:  const { orderId } = useParams();
src\pages\AdminOrderDetails.tsx:
src\pages\AdminOrderDetails.tsx:  const [order, setOrder] = useState<Order | null>(null);
src\pages\AdminOrderDetails.tsx:  const [loading, setLoading] = useState(true);
src\pages\AdminOrderDetails.tsx:  const [error, setError] = useState("");
src\pages\AdminOrderDetails.tsx:
src\pages\AdminOrderDetails.tsx:  const isAdmin =
src\pages\AdminOrderDetails.tsx:    keycloak.hasRealmRole("ADMIN") ||
src\pages\AdminOrderDetails.tsx:    keycloak.hasResourceRole("ADMIN", "neoshop");
src\pages\AdminOrderDetails.tsx:
src\pages\AdminOrderDetails.tsx:  useEffect(() => {
src\pages\AdminOrderDetails.tsx:    const loadOrder = async () => {
src\pages\AdminOrderDetails.tsx:      try {
src\pages\AdminOrderDetails.tsx:        setLoading(true);
src\pages\AdminOrderDetails.tsx:        setError("");
src\pages\AdminOrderDetails.tsx:
src\pages\AdminOrderDetails.tsx:        if (!orderId) {
src\pages\AdminOrderDetails.tsx:          throw new Error("Order ID is missing.");
src\pages\AdminOrderDetails.tsx:        }
src\pages\AdminOrderDetails.tsx:
src\pages\AdminOrderDetails.tsx:        const data = await getOrderById(Number(orderId));
src\pages\AdminOrderDetails.tsx:
src\pages\AdminOrderDetails.tsx:        setOrder(data);
src\pages\AdminOrderDetails.tsx:      } catch (err) {
src\pages\AdminOrderDetails.tsx:        console.error(err);
src\pages\AdminOrderDetails.tsx:
src\pages\AdminOrderDetails.tsx:        if (err instanceof Error) {
src\pages\AdminOrderDetails.tsx:          setError(err.message);
src\pages\AdminOrderDetails.tsx:        } else {
src\pages\AdminOrderDetails.tsx:          setError("Failed to load order.");
src\pages\AdminOrderDetails.tsx:        }
src\pages\AdminOrderDetails.tsx:      } finally {
src\pages\AdminOrderDetails.tsx:        setLoading(false);
src\pages\AdminOrderDetails.tsx:      }
src\pages\AdminOrderDetails.tsx:    };
src\pages\AdminOrderDetails.tsx:
src\pages\AdminOrderDetails.tsx:    loadOrder();
src\pages\AdminOrderDetails.tsx:  }, [orderId]);
src\pages\AdminOrderDetails.tsx:
src\pages\AdminOrderDetails.tsx:  if (!isAdmin) {
src\pages\AdminOrderDetails.tsx:    return (
src\pages\AdminOrderDetails.tsx:      <main className="page">
src\pages\AdminOrderDetails.tsx:        <div className="error">
src\pages\AdminOrderDetails.tsx:          Admin access required.
