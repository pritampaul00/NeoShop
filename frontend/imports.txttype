src\pages\OrderDetails.tsx:        }
src\pages\OrderDetails.tsx:      } finally {
src\pages\OrderDetails.tsx:        setLoading(false);
src\pages\OrderDetails.tsx:      }
src\pages\OrderDetails.tsx:    };
src\pages\OrderDetails.tsx:
src\pages\OrderDetails.tsx:    loadOrder();
src\pages\OrderDetails.tsx:  }, [orderId]);
src\pages\OrderDetails.tsx:
src\pages\OrderDetails.tsx:  const handleCancelOrder = async () => {
